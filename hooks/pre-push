#!/bin/sh
# Pre-push gate: full test suite must pass before ANY push (which auto-deploys).
# Installed per machine: cp hooks/pre-push .git/hooks/pre-push
#
# NOTE (8/2): the original piped vitest into tail and then read $? — which was
# TAIL's exit code, so a failing suite could slip through (it did, once). The
# output is captured first now; $? is vitest's own exit code.
echo "[pre-push] Running full test suite before push (push auto-deploys prod)..."
OUT=$(npx vitest run --silent 2>&1)
code=$?
echo "$OUT" | tail -5
if [ $code -ne 0 ]; then
  echo "[pre-push] TESTS FAILED (exit $code) - push blocked. Fix tests or the code, then push again."
  exit 1
fi
echo "[pre-push] All tests green - push allowed."
exit 0
